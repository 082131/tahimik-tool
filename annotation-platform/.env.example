# Supabase project credentials.
#
# Copy this file to `.env` and fill in the real values. `.env` is gitignored
# and must never be committed.
#
# Use the ANON key only — it is the public client key and is protected by Row
# Level Security. The service-role key bypasses RLS entirely and must never
# appear in frontend code or in this repository.
#
# Find both under: Supabase dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
